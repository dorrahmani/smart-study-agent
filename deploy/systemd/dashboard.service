# Captured from the VM (systemctl cat). The last [Service] block is the drop-in
# /etc/systemd/system/dashboard.service.d/*.conf (daily restart, always restart).
[Unit]
Description=Smart Study Agent Dashboard (Streamlit)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/smart_study_agent
EnvironmentFile=/home/ubuntu/smart_study_agent/.env
ExecStart=/home/ubuntu/smart_study_agent/venv/bin/streamlit run dashboard/app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --browser.gatherUsageStats=false \
    --server.enableCORS=true \
    --server.enableXsrfProtection=true \
    --server.maxUploadSize=200 \
    --server.maxMessageSize=200
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/smart_study_agent/logs/dashboard.log
StandardError=append:/home/ubuntu/smart_study_agent/logs/dashboard.log

[Install]
WantedBy=multi-user.target

[Service]
RuntimeMaxSec=86400
Restart=always
RestartSec=10
