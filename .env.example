# ════════════════════════════════════════════════════════════════════
#  Personal WhatsApp assistant — environment template
#  Copy to .env and fill in:   python scripts/setup_check.py --init   (or: cp .env.example .env)
#  .env is gitignored — NEVER commit it. Check with: python scripts/setup_check.py
#  Everything is empty on purpose. SETUP.md explains where to get each value.
#
#  Part A (sections 1–4) is all the assistant needs. Part B switches on the student domain.
# ════════════════════════════════════════════════════════════════════

# ═════════════════════ PART A — THE ASSISTANT ═══════════════════════

# ── 1. REQUIRED — Gemini (the ONLY LLM: the bot, reading files/images, summaries) ─
# https://aistudio.google.com/apikey  (enable billing + set a budget alert in Google Cloud)
GEMINI_API_KEY=
# Optional fallback; if set it MUST also be a Gemini key.
GOOGLE_API_KEY=

# ── 2. REQUIRED — WhatsApp (your OWN number, through a linked device) ─
# WA_TRANSPORT=bridge uses whatsapp/bridge.py (a linked device, like WhatsApp Web).
WA_TRANSPORT=bridge
# YOUR phone number, international digits only, e.g. 9725XXXXXXXX. The bot obeys only this number.
WA_OWNER=
# The number of the WhatsApp account the bridge is linked to. A SECOND number (SIM / eSIM): the bridge ignores
# messages sent from its own account, so with WA_OWNER on the same number it would never hear you.
WA_BOT_NUMBER=
# Optional: exact chat id of the owner if the bridge reports a different one (…@lid).
WA_OWNER_CHAT=
# How the bot calls you in messages.
WA_OWNER_NAME=
# Partner mode (optional): how the bot calls your partner + the numbers allowed to talk to it (comma-separated).
WA_PARTNER_NAME=
WA_ALLOWED=
# WA_DATA_DIR=                             # default data/wa_bridge
# WA_SPOOL_DIR=                            # default data/wa_spool
# --- Only for the Meta WhatsApp Cloud API transport (not needed for bridge) ---
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
# SSA_GROUPS=1                             # allow the bot in groups (only when tagged)

# ── 3. Google Calendar ────────────────────────────────────────────────
# No variable: run once  python scripts/gcal_auth.py <client.json>  → config/gcal_token.json (gitignored).

# ── 4. Behaviour (defaults are fine) ──────────────────────────────────
# SSA_PROACTIVE=1                          # the noticing layer (trip → packing list, …), capped per day
# SSA_QUIET_HOURS=23-7
# The agent loop (agent/mind.py): Gemini with read-only tools. Recommended. Unset/0 = the older one-call router.
SSA_BRAIN=1
# SSA_BRAIN_MODEL= / SSA_BRAIN_DAY_CAP=1 / SSA_BRAIN_MAX_COST=0.10   # USD a day / a message
# SSA_NOTIFY_CHANNEL=whatsapp              # whatsapp | telegram
# SSA_BRAIN_THINKING=low                   # Gemini thinking level of the agent loop (low = cheaper, faster)
# SSA_BRAIN_TIMEOUT=70                     # seconds one owner turn may take before it answers what it has
# SSA_ESCALATE=1                           # 0 = a reminder you did not answer is never repeated ("🔔 שוב")
# SSA_DOMAINS=student                      # life domains that may add lines to the prompts (student = only with SSA_STUDY=1)
# SSA_WEB_MODEL=gemini-3.1-flash-lite      # the one small call that answers a web question from fetched pages

# ── 4b. Alerts OUTSIDE WhatsApp (optional, scripts/wa_bridge_watch.py) ─
# When the WhatsApp link drops, WhatsApp itself can't tell you. The watch e-mails RECIPIENT_EMAIL (Gmail token, part B §7)
# and/or pushes to the ntfy app on your phone. Use a LONG random topic: anyone who knows it can read it.
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# ── 4c. Gemini on a personal subscription instead of the API (OPTIONAL, OFF by default) ─
# Read utils/gemini_sub.py and docs/COSTS.md first. It drives a personal Google AI Pro account through the Antigravity
# CLI, isolated as its own Linux user (deploy/gemini_agent/). Google's terms may not allow automated use: use a separate
# account. Saves the API price on plain chat, summaries and the site build; everything works without it.
# Third-party text (groups, mail, web pages, files) never goes to it.
# SSA_SUBSCRIPTION=1                       # the master switch (unset = off)
# SSA_BOT_VIA_GEMINI_SUB=1                 # the WhatsApp worker's text calls try it first
# SSA_SUMMARY_VIA_SUB=1 / SSA_FORMULA_VIA_SUB=1   # lecture summaries / their formula check try it first (0 = API only)
# SSA_GEMINI_SUB_TIMEOUT=60 / SSA_GEMINI_SUB_SLOTS=2

# ── 4d. Costs ─────────────────────────────────────────────────────────
# SSA_MONTH_CAP_USD=50                     # the hard monthly lock (all paid calls stop above it). A different cap for one
#                                          # month: config/budget_caps.json  {"months": {"2026-12": 20}}
# SSA_SITE_API_CAP=0.10                    # the nightly course-site build may pay the API at most this much a night
# Telegram (optional second channel / alerts). ⚠ If TELEGRAM_USER_ID is EMPTY the bot answers everyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Dashboard (Streamlit, 127.0.0.1 only — reach it via SSH tunnel / Tailscale). Refuses access without a password.
DASHBOARD_PASSWORD=
DASHBOARD_FRIEND_PASSWORD=

# ═════════════════════ PART B — THE STUDENT DOMAIN ══════════════════
# Off by default. 1 = courses, Moodle/Panopto, university mail, obligations, summaries, course site, NotebookLM.
SSA_STUDY=0

# ── 5. University login (Panopto, Moodle, my.tau) ────────────────────
TAU_USERNAME=
TAU_ID=
TAU_PASSWORD=
# This semester's course keys (must exist in config/courses.yaml).
SSA_ACTIVE_COURSES=
# SMART_STUDY_FORCE=1                      # run the lecture pipeline even outside the semester window
# SMART_STUDY_DISABLE=1                    # hard off-switch for the lecture pipeline
# PRIMER_LEAD_MIN=75                       # minutes before class to send the primer
# SSA_SUMMARY_MODEL=                       # override the Gemini model for summaries
# SSA_STARTER_REPO=                        # 'owner/repo' of a PUBLIC repo you help friends set up: tag the bot in a
#                                          # group with a setup question and it answers from that repo only (empty = off)
# SSA_UNIVERSITY=אוניברסיטת תל אביב         # your university's name, in the assistant's sense of who you are
# SSA_COURSE_SITE_URL=                      # your private course site (scripts/build_course_site.py), e.g. a Tailscale URL
# SSA_UNI_MAIL_DOMAIN=mail.tau.ac.il        # your own university address stays in vault notes (other e-mails are scrubbed)
# SSA_GRADES=1                              # grades + the grader's feedback from Moodle → one message, a log, a weakness profile
# SSA_FORMULA_CHECK=1                       # a second Gemini pass that checks the formulas of a long summary (0 = skip)
# Your own university instead of the TAU example: config/university_pages.json (web search), config/campus.json
# (walking times between buildings), config/student_lines.txt (extra lines for the assistant). All optional.

# ── 6. Paid transcription when a lecture has no captions (optional) ─
# https://platform.openai.com/api-keys  — used ONLY for audio transcription: voice notes you send the bot
# (part A too: without it, write to the bot in text) and lectures without captions.
OPENAI_API_KEY=
# SMART_STUDY_DISABLE_WHISPER=1            # never pay for transcription
# SSA_TRANSCRIBE_MODEL=gpt-4o-transcribe   # or whisper-1
# Order for a lecture: Panopto captions first (a recording without them waits up to 48 h, unless an exam of the course
# is within 2 days) → local transcription on the server's CPU ($0) → the paid API above, last.
# SSA_LOCAL_ASR=1                          # 0 = skip the local step. Needs its own venv with faster-whisper and a CT2
#                                          # Hebrew model (see docs/COSTS.md); without them the step is skipped
# SSA_ASR_PYTHON=/home/ubuntu/venv_asr/bin/python
# SSA_ASR_MODEL=/home/ubuntu/asr_models/ivrit-turbo-ct2
# Standing authorisations (deadlines into your own calendar without a card each time): config/assistant.yaml,
# copied from config/assistant.example.yaml. Obligations no collector can see: config/obligations.yaml (example file too).

# ── 7. Summaries by e-mail (Gmail OAuth) ─────────────────────────────
# OAuth client JSON (Desktop app) as ONE line. First run opens a browser; the token is cached
# in config/gmail_token.pickle (gitignored).
GMAIL_CREDENTIALS_JSON=
RECIPIENT_EMAIL=

# ═════════════════════ BOTH — server, paths, costs ══════════════════

# ── 8. Server / security checks (only if you run it on a VPS) ────────
# Used by scripts/pc/*, scripts/local_vm_*.py/.ps1, scripts/set_claude_token.ps1
VM_IP=
VM_USER=ubuntu
SSH_KEY=
SSA_SERVER=
# Fingerprint(s) of the ONLY ssh keys allowed on the server (ssh-keygen -lf key.pub), comma-separated.
SSA_AUTHORIZED_KEYS=
# OCI_INSTANCE_ID=
# BACKUP_GPG_RECIPIENT=                    # your GPG key fingerprint: backup_to_drive.sh encrypts to it, backup_restore_test checks it
# BACKUP_REMOTE=gdrive:smart-study-agent-backup   # the rclone remote the weekly restore test reads (rclone COPY only)

# ── 8b. The bot answers you about itself (agent/project_qa.py, owner only; one small Gemini call, cached per commit) ─
# SSA_PROJECT_MODEL=gemini-3.1-flash-lite
# SSA_SELF_PROJECT=                        # this repo's name in the projects digest (default: the folder name)
# Optional, on your PC: scripts/pc/projects_digest.py --push maps your OTHER projects too (uses SSA_SERVER + SSH_KEY).
# SSA_PROJECT_ROOTS=                       # comma list of folders to look in (default: home + ~/Documents)
# SSA_SENSITIVE_RX=                        # regex of project names that may hold other people's data: docs + structure only
# SSA_REMOTE_ROOT=/home/ubuntu/smart_study_agent

# ── 9. Paths (defaults are fine) ─────────────────────────────────────
# SMART_STUDY_ROOT=
# SMART_STUDY_DATA_DIR=                    # default <root>/data
# SMART_STUDY_CONFIG_DIR=                  # default <root>/config
# SMART_STUDY_VAULT=                       # Obsidian vault root (default ~/Documents/Obsidian Vault)
# OBSIDIAN_VAULT_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=

# ── 10. Optional · cost dashboard (generators/cost_tracker.py) ───────
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_BILLING_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
