# ════════════════════════════════════════════════════════════════════
#  Smart Study Agent — environment template
#  Copy to .env and fill in:   cp .env.example .env   (Windows: copy .env.example .env)
#  .env is gitignored — NEVER commit it. Check with: python scripts/setup_check.py
#  Everything is empty on purpose. SETUP.md explains where to get each value.
# ════════════════════════════════════════════════════════════════════

# ── 1. REQUIRED — university login (Panopto, Moodle, my.tau) ────────
# Your TAU SSO username, ID number (the login form asks for it) and password.
TAU_USERNAME=
TAU_ID=
TAU_PASSWORD=

# ── 2. REQUIRED — Gemini (the ONLY LLM: summaries, bot, quizzes, OCR) ─
# https://aistudio.google.com/apikey  (enable billing + set a budget alert in Google Cloud)
GEMINI_API_KEY=
# Optional fallback; if set it MUST also be a Gemini key.
GOOGLE_API_KEY=

# ── 3. OPTIONAL — paid transcription when a lecture has no captions ─
# https://platform.openai.com/api-keys  — used ONLY for audio transcription.
OPENAI_API_KEY=
# SMART_STUDY_DISABLE_WHISPER=1            # never pay for transcription
# SSA_TRANSCRIBE_MODEL=gpt-4o-transcribe   # or whisper-1

# ── 4. WhatsApp secretary bot (your OWN number, linked device) ───────
# WA_TRANSPORT=bridge uses whatsapp/bridge.py (a linked device, like WhatsApp Web).
WA_TRANSPORT=bridge
# YOUR phone number, international digits only, e.g. 9725XXXXXXXX.
WA_OWNER=
# Optional: exact chat id of the owner if the bridge reports a different one (…@lid).
WA_OWNER_CHAT=
# Comma-separated numbers allowed to talk to the bot (owner is always allowed).
WA_ALLOWED=
# How the bot calls you and your partner in messages.
WA_OWNER_NAME=
WA_PARTNER_NAME=
# The number of the WhatsApp account the bridge is linked to (if it's a second SIM).
WA_BOT_NUMBER=
# WA_DATA_DIR=                             # default data/wa_bridge
# WA_SPOOL_DIR=                            # default data/wa_spool
# --- Only for the Meta WhatsApp Cloud API transport (not needed for bridge) ---
# WA_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=
# SSA_GROUPS=1                             # allow the bot in groups (only when tagged)

# ── 5. Telegram (optional second channel / alerts) ────────────────────
# @BotFather → /newbot. TELEGRAM_USER_ID = your numeric chat id (comma-separated list).
# ⚠ If TELEGRAM_USER_ID is EMPTY the bot answers everyone. Always set it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# SSA_NOTIFY_CHANNEL=whatsapp              # whatsapp | telegram

# ── 6. E-mail (Gmail OAuth) ──────────────────────────────────────────
# OAuth client JSON (Desktop app) as ONE line. First run opens a browser; the token is cached
# in config/gmail_token.pickle (gitignored).
GMAIL_CREDENTIALS_JSON=
RECIPIENT_EMAIL=

# ── 7. Dashboard (Streamlit, 127.0.0.1 only — reach it via SSH tunnel / Tailscale) ─
# Required: without a password the dashboard refuses access.
DASHBOARD_PASSWORD=
DASHBOARD_FRIEND_PASSWORD=

# ── 8. Server / security checks (only if you run it on a VPS) ────────
# Used by scripts/pc/*, scripts/local_vm_*.py/.ps1, scripts/set_claude_token.ps1
VM_IP=
VM_USER=ubuntu
SSH_KEY=
SSA_SERVER=
# Fingerprint(s) of the ONLY ssh keys allowed on the server (ssh-keygen -lf key.pub), comma-separated.
SSA_AUTHORIZED_KEYS=
# OCI_INSTANCE_ID=
# BACKUP_GPG_RECIPIENT=                    # scripts/backup_to_drive.sh (encrypted secrets backup)

# ── 9. Courses / behaviour ───────────────────────────────────────────
# This semester's course keys (must exist in config/courses.yaml).
SSA_ACTIVE_COURSES=
# SMART_STUDY_FORCE=1                      # run even outside the semester window
# SMART_STUDY_DISABLE=1                    # hard off-switch for the pipeline
# PRIMER_LEAD_MIN=75                       # minutes before class to send the primer
# SSA_QUIET_HOURS=23-7
# SSA_SUMMARY_MODEL=                       # override the Gemini model for summaries
# SSA_BRAIN_MODEL= / SSA_BRAIN_DAY_CAP= / SSA_BRAIN_MAX_COST=
# SSA_STARTER_REPO=                        # 'owner/repo' of a public template to help friends with (optional)

# ── 10. Paths (defaults are fine) ────────────────────────────────────
# SMART_STUDY_ROOT=
# SMART_STUDY_DATA_DIR=                    # default <root>/data
# SMART_STUDY_CONFIG_DIR=                  # default <root>/config
# SMART_STUDY_VAULT=                       # Obsidian vault root (default ~/Documents/Obsidian Vault)
# OBSIDIAN_VAULT_PATH=
# FFMPEG_PATH=
# FFPROBE_PATH=

# ── 11. Optional · cost dashboard (generators/cost_tracker.py) ───────
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_BILLING_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=
