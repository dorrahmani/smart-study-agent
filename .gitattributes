# Normalize to LF in the repo. Critical: the Oracle VM is Linux — .sh files
# checked out with CRLF fail there with "bad interpreter: No such file".
* text=auto eol=lf

# Windows-only launchers keep CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# Never touch binaries
*.png  binary
*.jpg  binary
*.pdf  binary
*.pickle binary
